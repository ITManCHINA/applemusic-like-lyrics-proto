{
  "name": "@applemusic-like-lyrics/lyric",
  "version": "1.1.0",
  "description": "一个歌词解析/生成模块，着重于歌词内容解析，支持多种格式",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Steve-xmh/applemusic-like-lyrics"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/amll-lyric.cjs",
  "module": "./dist/amll-lyric.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/amll-lyric.js",
      "require": "./dist/amll-lyric.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build",
    "fmt": "biome format --write ./src"
  },
  "devDependencies": {
    "@biomejs/biome": "1.5.3",
    "@types/node": "^20.0.0",
    "@types/pako": "^2.0.3",
    "typescript": "^5.2.2",
    "vite": "^4.4.11",
    "vite-plugin-dts": "^3.6.0"
  },
  "dependencies": {
    "@applemusic-like-lyrics/ttml": "workspace:*",
    "pako": "^2.1.0"
  }
}
